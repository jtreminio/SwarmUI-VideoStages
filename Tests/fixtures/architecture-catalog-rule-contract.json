{
  "descriptor": {
    "id": "ltx2",
    "label": "LTX Video 2.3",
    "capabilities": {
      "features": [
        "prompt-relay",
        "frame-references",
        "reference-framing",
        "retake",
        "audio-sources",
        "audio-segments",
        "audio-reuse",
        "audio-derived-duration",
        "control-signal-derived-duration",
        "ic-lora"
      ],
      "entryModes": [
        "text-to-video",
        "image-to-video",
        "init-video"
      ],
      "audioSourceKinds": [
        "Native",
        "Upload",
        "ControlNet",
        "AceStepFun"
      ]
    },
    "boundaryRules": {
      "cut": {
        "support": "supported",
        "code": "ltx2.boundary.cut",
        "reason": "Decoded LTX clips can be joined with a hard cut.",
        "scope": "boundary",
        "constraints": null
      },
      "continue": {
        "support": "conditional",
        "code": "ltx2.boundary.continue",
        "reason": "Continue requires adjacent LTX clips and a compatible generated target.",
        "scope": "boundary",
        "constraints": {
          "sameArchitecture": true,
          "frameStep": 8,
          "minFrames": 8,
          "maxFrames": 48,
          "defaultFrames": 8,
          "continuityExtraFrames": 1,
          "targetRequiresGeneratedEntry": true,
          "targetRequiresStage": true,
          "targetDisallowsInitialReference": true
        }
      },
      "crossfade": {
        "support": "conditional",
        "code": "ltx2.boundary.crossfade",
        "reason": "Crossfade currently uses the LTX-owned decoded transition path.",
        "scope": "boundary",
        "constraints": {
          "sameArchitecture": true,
          "frameStep": 8,
          "minFrames": 8,
          "maxFrames": 48,
          "defaultFrames": 8,
          "continuityExtraFrames": 0,
          "targetRequiresGeneratedEntry": false,
          "targetRequiresStage": false,
          "targetDisallowsInitialReference": false
        }
      }
    },
    "rules": [
      {
        "support": "conditional",
        "code": "retake-source-required",
        "reason": "Retake requires an init-video clip.",
        "scope": "clip",
        "constraints": null
      }
    ]
  }
}
