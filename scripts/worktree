#! /bin/bash
# Provision or tear down an agent worktree that can run `./run-tests`.
set -euo pipefail

# Hard-coded so the script can only ever touch this extension: every path it creates or
# deletes is "<extensions>/SwarmUI-VideoStages-<name>", never a sibling extension and
# never a worktree of another repo.
REPO="SwarmUI-VideoStages"
ARTIFACTS_ROOT="/tmp/swarmui-msbuild"

die() { echo "$*" >&2; exit 1; }

# The main checkout, not wherever this copy of the script lives — worktrees are always
# siblings of it, never nested. `git worktree list` always prints the main worktree first.
# (read whole, then slice: piping into `head` would SIGPIPE git and trip `pipefail`)
MAIN="$(git -C "$(dirname "${BASH_SOURCE[0]}")" worktree list --porcelain)"
MAIN="${MAIN%%$'\n'*}"
MAIN="${MAIN#worktree }"
[ "$(basename "$MAIN")" = "$REPO" ] || die "not a $REPO checkout: $MAIN"
EXTENSIONS="$(dirname "$MAIN")"

usage() {
    cat <<EOF
Usage:
  scripts/worktree add [--resume] <name> [start-point]   provision $EXTENSIONS/$REPO-<name>
  scripts/worktree rm  [--keep-branch] <name>            remove it and its build output
  scripts/worktree ls                                    list worktrees of this repo

<name> is the suffix only: letters, digits and dashes, not starting with a dash.
\`add\` and \`rm\` only run from $MAIN itself, never from inside a worktree.

\`add\` creates branch <name> from [start-point] (default HEAD). If that branch already
exists it refuses, because silently resuming someone else's commits under a fresh-looking
worktree is how an agent ends up building on work it cannot see — pass --resume when
continuing it is what you meant.

\`rm\` deletes branch <name> once every one of its commits is in HEAD, compared by patch
id, so a branch harvested with cherry-pick still counts as done. Otherwise it keeps the
branch and says how many commits would be lost. --keep-branch skips the check entirely.
EOF
}

# Rejects path traversal, globs, whitespace and anything git would read as an option. Every
# other use of $name — path, branch, artifacts dir — trusts this check and nothing else.
check_name() {
    local name="${1-}"
    [ -n "$name" ] || die "name required"
    [ "${#name}" -le 40 ] || die "name too long (40 max): $name"
    case "$name" in
        -*) die "name may not start with a dash: $name" ;;
        *[!A-Za-z0-9-]*) die "name may only contain A-Za-z0-9 and dashes: $name" ;;
    esac
}

# Provisioning and teardown belong to whoever is orchestrating from the main checkout: an
# agent standing in a worktree must not be able to spawn more or delete a sibling's work.
# `--show-toplevel` names the worktree the caller is actually in, so this also refuses the
# worktrees that live *under* $MAIN (.claude/worktrees/*), which a path prefix would miss.
require_main_checkout() {
    local top
    top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ "$top" = "$MAIN" ] || die "run '$1' from the main checkout $MAIN — cwd is ${top:-$PWD}"
}

# The worktree must land at src/Extensions/<dir>. The csproj imports
# ../../SwarmUI.extension.props, and core's SwarmUI.csproj compiles src/**/*.cs with
# only Extensions/** removed — anywhere else under src/ and the worktree's own
# sources get swept into core's build.
worktree_path() { echo "$EXTENSIONS/$REPO-$1"; }
artifacts_path() { echo "$ARTIFACTS_ROOT/wt-$1"; }

# Hooks are not versioned, so a fresh clone has none; refresh on every add so an edited
# source never leaves a stale copy behind. Hooks live in the common dir, shared by every
# worktree, so installing once covers them all.
install_hook() {
    local src="$MAIN/scripts/worktree-post-checkout" dest
    dest="$(git -C "$MAIN" rev-parse --path-format=absolute --git-common-dir)/hooks/post-checkout"
    [ -f "$src" ] || die "missing $src"
    cmp -s "$src" "$dest" 2>/dev/null && return
    mkdir -p "$(dirname "$dest")"
    cp "$src" "$dest"
    chmod +x "$dest"
    echo "installed $dest"
}

cmd_add() {
    require_main_checkout add
    local resume=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --resume) resume=1; shift ;;
            --) shift; break ;;
            -*) die "unknown option: $1" ;;
            *) break ;;
        esac
    done
    [ $# -le 2 ] || die "add takes only [--resume] <name> [start-point]"
    local name="${1-}" start="${2:-HEAD}"
    check_name "$name"
    [ "$resume" = 0 ] || [ $# -le 1 ] || die "--resume continues branch $name; it takes no start-point"
    case "$start" in -*) die "start-point may not start with a dash: $start" ;; esac
    git -C "$MAIN" rev-parse --verify --quiet "$start^{commit}" >/dev/null \
        || die "unknown start-point: $start"

    local path artifacts
    path="$(worktree_path "$name")"
    artifacts="$(artifacts_path "$name")"
    if [ -e "$path" ]; then
        echo "already exists: $path" >&2
        exit 1
    fi

    # The hook owns provisioning, so it has to be in place before the worktree exists. It also
    # catches a worktree made by a bare `git worktree add` or by an agent harness, which never
    # come through this script.
    install_hook

    if git -C "$MAIN" show-ref --quiet --verify "refs/heads/$name"; then
        [ "$resume" = 1 ] || die "branch $name already exists at $(git -C "$MAIN" log --oneline -1 "$name")
a worktree on it would start with those commits already applied — pass --resume if that is
what you want, otherwise pick another name"
        git -C "$MAIN" worktree add "$path" "$name"
    else
        git -C "$MAIN" worktree add "$path" -b "$name" "$start"
    fi
    [ -d "$MAIN/node_modules" ] \
        || echo "warning: $MAIN/node_modules missing — run 'npm ci' in the main checkout, jest will fail" >&2

    cat <<EOF

worktree  $path
branch    $(git -C "$path" rev-parse --abbrev-ref HEAD) @ $(git -C "$path" log --oneline -1)
output    $artifacts

Run tests with: cd "$path" && ./run-tests
Tear down with: scripts/worktree rm $name
SwarmUI loads every subdirectory of src/Extensions at startup — leaving this in place
double-loads the extension on the next restart.
EOF
}

cmd_rm() {
    require_main_checkout rm
    local keep_branch=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --keep-branch) keep_branch=1; shift ;;
            --) shift; break ;;
            -*) die "unknown option: $1" ;;
            *) break ;;
        esac
    done
    [ $# -le 1 ] || die "rm takes only [--keep-branch] <name>"
    local name="${1-}" path
    check_name "$name"
    path="$(worktree_path "$name")"
    # Only ever tear down a worktree git already tracks for this repo, so a mistyped or
    # stale name deletes nothing. Deliberately no --force passthrough: anything left dirty
    # is the agent's own unharvested work.
    grep -qxF "worktree $path" <<<"$(git -C "$MAIN" worktree list --porcelain)" \
        || die "not a worktree of $MAIN: $path"

    # A worktree the hook relocated left a symlink at the path its creator asked for, which
    # can be anywhere, so the hook recorded it. Read it before the admin dir goes away.
    local relocated_from="" admin
    admin="$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null || true)"
    [ -z "$admin" ] || [ ! -f "$admin/relocated-from" ] || relocated_from="$(<"$admin/relocated-from")"

    rm -f "$path/node_modules" "$path/nonversioned" "$path/Directory.Build.rsp"
    git -C "$MAIN" worktree remove "$path"
    rm -rf "$(artifacts_path "$name")"
    echo "removed $path"

    # Only ever unlink a symlink that still points at what was just removed.
    if [ -L "$relocated_from" ] && [ "$(readlink "$relocated_from")" = "$path" ]; then
        rm -f "$relocated_from"
        echo "removed dangling $relocated_from"
    fi

    if [ "$keep_branch" = 1 ]; then
        echo "kept branch $name"
        return
    fi
    git -C "$MAIN" show-ref --quiet --verify "refs/heads/$name" || return
    # By patch id, not reachability: harvesting with cherry-pick leaves the branch's own
    # commits unreachable from HEAD, so `branch -d` would refuse every branch this script
    # makes. `git cherry` marks a commit `-` once an equivalent patch is upstream, `+` when
    # it is nowhere else.
    local unharvested
    unharvested="$(git -C "$MAIN" cherry HEAD "$name" | grep -c '^+' || true)"
    if [ "$unharvested" -eq 0 ]; then
        git -C "$MAIN" branch -D "$name" >/dev/null
        echo "deleted branch $name — every commit is already in HEAD"
    else
        echo "kept branch $name — $unharvested commit(s) are in no other branch." >&2
        echo "harvest them, then: git branch -D $name" >&2
    fi
}

case "${1:-}" in
    add) shift; cmd_add "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    ls) git -C "$MAIN" worktree list ;;
    *) usage; exit 1 ;;
esac
