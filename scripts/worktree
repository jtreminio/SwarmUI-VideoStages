#! /bin/bash
# Provision or tear down an agent worktree that can run `./run-tests`.
set -euo pipefail

# Hard-coded so the script can only ever touch this extension: every path it creates or
# deletes is "<extensions>/SwarmUI-VideoStages-<name>", never a sibling extension and
# never a worktree of another repo.
REPO="SwarmUI-VideoStages"
ARTIFACTS_ROOT="/tmp/swarmui-msbuild"

die() { echo "$*" >&2; exit 1; }

# The main checkout, not wherever this copy of the script lives — worktrees are always
# siblings of it, never nested. `git worktree list` always prints the main worktree first.
# (read whole, then slice: piping into `head` would SIGPIPE git and trip `pipefail`)
MAIN="$(git -C "$(dirname "${BASH_SOURCE[0]}")" worktree list --porcelain)"
MAIN="${MAIN%%$'\n'*}"
MAIN="${MAIN#worktree }"
[ "$(basename "$MAIN")" = "$REPO" ] || die "not a $REPO checkout: $MAIN"
EXTENSIONS="$(dirname "$MAIN")"

usage() {
    cat <<EOF
Usage:
  scripts/worktree add <name> [start-point]   provision $EXTENSIONS/$REPO-<name>
  scripts/worktree rm  <name>                 remove it and its build output
  scripts/worktree ls                         list worktrees of this repo

<name> is the suffix only: letters, digits and dashes, not starting with a dash.
\`add\` and \`rm\` only run from $MAIN itself, never from inside a worktree.

\`add\` checks out branch <name> if it exists, otherwise creates it from
[start-point] (default HEAD).
EOF
}

# Rejects path traversal, globs, whitespace and anything git would read as an option. Every
# other use of \$name — path, branch, artifacts dir — trusts this check and nothing else.
check_name() {
    local name="${1-}"
    [ -n "$name" ] || die "name required"
    [ "${#name}" -le 40 ] || die "name too long (40 max): $name"
    case "$name" in
        -*) die "name may not start with a dash: $name" ;;
        *[!A-Za-z0-9-]*) die "name may only contain A-Za-z0-9 and dashes: $name" ;;
    esac
}

# Provisioning and teardown belong to whoever is orchestrating from the main checkout: an
# agent standing in a worktree must not be able to spawn more or delete a sibling's work.
# `--show-toplevel` names the worktree the caller is actually in, so this also refuses the
# worktrees that live *under* $MAIN (.claude/worktrees/*), which a path prefix would miss.
require_main_checkout() {
    local top
    top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ "$top" = "$MAIN" ] || die "run '$1' from the main checkout $MAIN — cwd is ${top:-$PWD}"
}

# The worktree must land at src/Extensions/<dir>. The csproj imports
# ../../SwarmUI.extension.props, and core's SwarmUI.csproj compiles src/**/*.cs with
# only Extensions/** removed — anywhere else under src/ and the worktree's own
# sources get swept into core's build.
worktree_path() { echo "$EXTENSIONS/$REPO-$1"; }
artifacts_path() { echo "$ARTIFACTS_ROOT/wt-$1"; }

cmd_add() {
    require_main_checkout add
    [ $# -le 2 ] || die "add takes only <name> [start-point]"
    local name="${1-}" start="${2:-HEAD}"
    check_name "$name"
    case "$start" in -*) die "start-point may not start with a dash: $start" ;; esac
    git -C "$MAIN" rev-parse --verify --quiet "$start^{commit}" >/dev/null \
        || die "unknown start-point: $start"

    local path artifacts
    path="$(worktree_path "$name")"
    artifacts="$(artifacts_path "$name")"
    if [ -e "$path" ]; then
        echo "already exists: $path" >&2
        exit 1
    fi

    if git -C "$MAIN" show-ref --quiet --verify "refs/heads/$name"; then
        git -C "$MAIN" worktree add "$path" "$name"
    else
        git -C "$MAIN" worktree add "$path" -b "$name" "$start"
    fi

    # node_modules and nonversioned are untracked, so a fresh worktree has neither.
    # Sharing beats a 280 MB `npm ci`, and reports land where the owner looks for them.
    if [ -d "$MAIN/node_modules" ]; then
        ln -s "$MAIN/node_modules" "$path/node_modules"
    else
        echo "warning: $MAIN/node_modules missing — run 'npm ci' in the main checkout, jest will fail" >&2
    fi
    if [ -d "$MAIN/nonversioned" ]; then
        ln -s "$MAIN/nonversioned" "$path/nonversioned"
    fi
    if [ -f "$MAIN/AGENTS.dev.md" ]; then
        cp "$MAIN/AGENTS.dev.md" "$path/AGENTS.dev.md"
    fi

    # dotnet honours Directory.Build.rsp for every project in the graph, including core's
    # SwarmUI.csproj — a props file cannot reach core, so it would keep building into the
    # shared src/bin|obj and collide with concurrent worktrees. Do NOT also copy
    # Directory.Build.local.props here; ArtifactsPath supersedes it.
    printf -- '-p:UseArtifactsOutput=true\n-p:ArtifactsPath=%s\n' "$artifacts" > "$path/Directory.Build.rsp"

    cat <<EOF

worktree  $path
branch    $(git -C "$path" rev-parse --abbrev-ref HEAD) @ $(git -C "$path" log --oneline -1)
output    $artifacts

Run tests with: cd "$path" && ./run-tests
Tear down with: scripts/worktree rm $name
SwarmUI loads every subdirectory of src/Extensions at startup — leaving this in place
double-loads the extension on the next restart.
EOF
}

cmd_rm() {
    require_main_checkout rm
    [ $# -le 1 ] || die "rm takes only <name>"
    local name="${1-}" path
    check_name "$name"
    path="$(worktree_path "$name")"
    # Only ever tear down a worktree git already tracks for this repo, so a mistyped or
    # stale name deletes nothing. Deliberately no --force passthrough: anything left dirty
    # is the agent's own unharvested work.
    grep -qxF "worktree $path" <<<"$(git -C "$MAIN" worktree list --porcelain)" \
        || die "not a worktree of $MAIN: $path"

    rm -f "$path/node_modules" "$path/nonversioned" "$path/Directory.Build.rsp"
    git -C "$MAIN" worktree remove "$path"
    rm -rf "$(artifacts_path "$name")"
    echo "removed $path"
}

case "${1:-}" in
    add) shift; cmd_add "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    ls) git -C "$MAIN" worktree list ;;
    *) usage; exit 1 ;;
esac
