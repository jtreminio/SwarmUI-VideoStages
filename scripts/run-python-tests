#! /bin/bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
python_args=()
if [ -n "${VIDEOSTAGES_PYTHON:-}" ]; then
    python_args=(--python "$VIDEOSTAGES_PYTHON")
fi

PYTHONPATH="$ROOT/comfy_node${PYTHONPATH:+:$PYTHONPATH}" \
    uv run --project "$ROOT/scripts/python-tests" --locked "${python_args[@]}" \
    python -m pytest -q "$ROOT/comfy_node/SwarmVideoStagesNodes/tests" "$@"
