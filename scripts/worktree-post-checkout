#! /bin/bash
# Provision a new worktree the moment git creates it, however it was created.
#
# Versioned source for .git/hooks/post-checkout, installed by `scripts/worktree add`.
# `.git/hooks` is not versioned and is shared by every worktree of this repo (git looks it
# up in the common dir), so this fires for `scripts/worktree add`, a hand-run
# `git worktree add`, and any worktree an agent harness makes on its own.
set -euo pipefail

# git fires nothing at all for `worktree remove` or `worktree prune` — measured against 2.51
# by tracing all 29 hooks. So teardown stays a command (`scripts/worktree rm`) and this hook
# carries the whole automatic half: creation, self-healing, and the stale-worktree warning.
PREV_HEAD="$1"
IS_BRANCH_CHECKOUT="$3"

[ "$IS_BRANCH_CHECKOUT" = "1" ] || exit 0

# git runs the hook inside whichever worktree was checked out.
WORKTREE="$PWD"
NAME="$(basename "$WORKTREE")"
MAIN="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"

# Null previous HEAD means git has just created this worktree. Only then is relocating it
# safe: after that someone may be standing in the directory, and moving it out from under a
# running agent is worse than the build failure it would fix.
IS_NEW_WORKTREE=0
[ "$PREV_HEAD" != "0000000000000000000000000000000000000000" ] || IS_NEW_WORKTREE=1

# A checkout in the main checkout is the one moment worth counting siblings: SwarmUI loads
# every subdirectory of src/Extensions at startup, so each leftover double-loads it.
if [ "$WORKTREE" = "$MAIN" ]; then
    stale="$(git worktree list --porcelain | sed -n "s|^worktree $MAIN-||p" | tr '\n' ' ')"
    [ -z "$stale" ] || cat >&2 <<EOF
note: worktrees still checked out beside this one: $stale
      each double-loads the extension on the next SwarmUI restart — scripts/worktree rm <name>
EOF
    exit 0
fi

# A worktree anywhere else cannot build: SwarmUI-VideoStages.csproj imports
# ../../SwarmUI.extension.props and references ../../SwarmUI.csproj, Tests references
# ..\..\..\SwarmUI.csproj, and MSBuild resolves those against the project file's REAL path.
# So relocate it and leave a symlink behind. The symlink direction is the whole trick: whoever
# asked for the original path still finds it, while MSBuild resolves through to the real
# directory under src/Extensions and its ../.. is SwarmUI's src/. The other direction — real
# directory elsewhere, symlink here — fails MSB4019 looking for "/SwarmUI.extension.props".
if [ ! -f "$WORKTREE/../../SwarmUI.extension.props" ]; then
    if [ "$IS_NEW_WORKTREE" = 0 ]; then
        cat >&2 <<EOF
note: this worktree cannot build where it is, and it is too late to move it safely.
      $WORKTREE
      Harvest what is here, then re-provision: cd $MAIN && scripts/worktree add <name>
EOF
        exit 0
    fi
    DEST="$MAIN-$NAME"
    if [ -e "$DEST" ]; then
        echo "cannot relocate $NAME: $DEST already exists" >&2
        exit 0
    fi
    # Move from the main checkout: git rewrites both the worktree's .git file and the
    # gitdir pointer in the common dir, which a bare `mv` would leave dangling.
    cd "$MAIN"
    # `git worktree move` is a rename, so it fails across filesystems (the harness has used
    # /tmp, which is tmpfs). Copy-then-repair is the same outcome by hand: `repair` rewrites
    # the .git file and the gitdir pointer to wherever the worktree now is.
    if ! git worktree move "$WORKTREE" "$DEST" 2>/dev/null; then
        if cp -a "$WORKTREE" "$DEST" 2>/dev/null && git worktree repair "$DEST" >/dev/null 2>&1; then
            rm -rf "${WORKTREE:?}"
        else
            rm -rf "$DEST"
        fi
    fi
    if [ ! -d "$DEST" ]; then
        cat >&2 <<EOF

  This worktree cannot build or run ./run-tests where it is, and moving it failed.

    worktree  $WORKTREE
    needs     $DEST

  Re-provision it from the main checkout instead:

      cd $MAIN && scripts/worktree add <name>

EOF
        exit 0
    fi
    ln -s "$DEST" "$WORKTREE"
    # So teardown can unlink it again wherever it was — the symlink can be outside the repo.
    echo "$WORKTREE" > "$(git -C "$DEST" rev-parse --absolute-git-dir)/relocated-from"
    echo "relocated $NAME to $DEST (a symlink keeps the original path working)"
    WORKTREE="$DEST"
fi

# node_modules and nonversioned are untracked, so a fresh worktree has neither. Sharing beats
# a 280 MB `npm ci`, and reports land where the owner looks for them.
[ -e "$WORKTREE/node_modules" ] || [ ! -d "$MAIN/node_modules" ] \
    || ln -s "$MAIN/node_modules" "$WORKTREE/node_modules"
[ -e "$WORKTREE/nonversioned" ] || [ ! -d "$MAIN/nonversioned" ] \
    || ln -s "$MAIN/nonversioned" "$WORKTREE/nonversioned"
[ -e "$WORKTREE/AGENTS.dev.md" ] || [ ! -f "$MAIN/AGENTS.dev.md" ] \
    || cp "$MAIN/AGENTS.dev.md" "$WORKTREE/AGENTS.dev.md"

# dotnet honours Directory.Build.rsp for every project in the graph, including core's
# SwarmUI.csproj — a props file cannot reach core, so it would keep building into the shared
# src/bin|obj and collide with concurrent worktrees.
[ -f "$WORKTREE/Directory.Build.rsp" ] || printf -- '-p:UseArtifactsOutput=true\n-p:ArtifactsPath=%s\n' \
    "/tmp/swarmui-msbuild/wt-${NAME#"$(basename "$MAIN")-"}" > "$WORKTREE/Directory.Build.rsp"

if [ "$IS_NEW_WORKTREE" = 0 ]; then
    # Quiet on an ordinary branch switch, where this only repairs what is missing. A worktree made
    # before this hook existed gets provisioned the first time anyone checks out in it.
    exit 0
fi
echo "provisioned $NAME — ./run-tests will work here"

# Capture what the suite looks like before anyone touches this worktree, so `./run-tests` can print
# it underneath every later run. Synchronous on purpose: a baseline that might not have landed yet
# is worse than none, because the first run reads "no baseline" and carries on. The cold build this
# pays for would happen on the agent's first run anyway.
[ "${VST_WORKTREE_BASELINE:-1}" = 1 ] || exit 0
[ -x "$WORKTREE/run-tests" ] || exit 0
echo "capturing its test baseline (cold build, ~25s) — scripts/worktree add --no-baseline skips this"
# Via a temp file, then move: redirecting straight at .test-baseline creates it before the suite
# starts, and `run-tests` would find it and record its own baseline-comparison output as the baseline.
{
    echo "# $(git -C "$WORKTREE" rev-parse --short HEAD), captured before any work in this worktree"
    # Unset git's per-command environment: it points at the *index and gitdir of this checkout*, and
    # anything the suite shells out to would inherit it and operate on the wrong worktree.
    (cd "$WORKTREE" && unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX && ./run-tests 2>&1)
} > "$WORKTREE/.test-baseline.part" || true
mv "$WORKTREE/.test-baseline.part" "$WORKTREE/.test-baseline"
grep -E "^(Passed!|Failed!|Test Suites:|Tests:)" "$WORKTREE/.test-baseline" | sed 's/^/  /' || true
if grep -qE "^(Failed!|Tests:.*failed)" "$WORKTREE/.test-baseline"; then
    echo "  NOTE: the baseline is red. That is the honest starting point, not a break you caused."
fi
exit 0
